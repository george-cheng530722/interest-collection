{
  "name": "george-interest-collection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "George's Picks — 離線優先、單機的手機網頁 App（PWA）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:single && playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "check:links": "node scripts/link-fetch-check.mjs",
    "proxy": "node proxy/server.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "csstype": "3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
